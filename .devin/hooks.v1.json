{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "if [ -f \"$HOME/.hermes/scripts/devin_dangerous_guard.py\" ]; then python3 \"$HOME/.hermes/scripts/devin_dangerous_guard.py\"; fi",
          "timeout": 5
        }
      ]
    }
  ]
}
